@article{zeng2026resolution,
  abbr        = {arXiv},
  bibtex_show = {true},
  title       = {The Resolution Hypothesis: Agent Evolution's Key Is Identifying Improvements},
  author      = {Zeng*, Yuanhao and Lan*, Shaocheng and Lu*, Ao and Yan, Kuang and Lin, Heng and Xu, Xinang and Luo, Yuan and Wang, Yueting and Li, Yexin and Shan, Ruo and Ren†, Kan},
  journal     = {arXiv preprint arXiv:2611.23068},
  year        = {2026},
  arxiv       = {2611.23068},
  url         = {https://arxiv.org/abs/2611.23068},
  html        = {https://arxiv.org/abs/2611.23068},
  pdf         = {https://arxiv.org/pdf/2611.23068},
  website     = {https://lineshogan.github.io/resolution-hypothesis/},
  blog        = {/blog/2026/resolution-hypothesis-behind-the-scenes/},
  annotation  = {* Equal contribution<br>† Corresponding author},
  abstract    = {Agent evolution follows a simple loop: a proposer writes candidate artifacts (prompts, skills, memories) and selection accepts those that score higher. Across seven evolution methods and six models (over 10M LLM calls), we trace why methods trade wins across papers and stall on coding tasks to the Resolution Hypothesis: agent evolution stalls not because methods fail to propose better artifacts, but because noisy evaluations cannot reliably identify them.},
  selected    = {true}
}

